#!/bin/sh
pso_control start
flight_mode_manager start
mc_pos_control start
land_detector start multicopter
mavlink stream -r 50 -s LOCAL_POSITION_NED -d /dev/ttyS3
mavlink stream -r 50 -s ATTITUDE -d /dev/ttyS3
mavlink stream -r 50 -s POSITION_TARGET_LOCAL_NED -d /dev/ttyS3
mavlink stream -r 50 -s ATTITUDE_TARGET -d /dev/ttyS3
